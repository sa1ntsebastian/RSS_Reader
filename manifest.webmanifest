{
  "name": "RSS Reader",
  "short_name": "RSS",
  "description": "Persönlicher Web-RSS-Reader",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#175d3b",
  "theme_color": "#175d3b",
  "orientation": "portrait",
