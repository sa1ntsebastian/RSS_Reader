# Block direct web access to the credentials file even if mod_php is off
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>
<Files "auth.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>
