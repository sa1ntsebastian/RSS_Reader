# Block direct web access to the credentials file even if mod_php is off
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>
<Files "auth.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# Pretty URLs for app icons so iOS sees clean .png paths instead of
# query strings (some iOS versions have caching issues with ?size=…)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^icon-([0-9]+)\.png$ assets/icon.php?size=$1 [L,QSA]
  RewriteRule ^apple-touch-icon-([0-9]+)\.png$ assets/icon.php?size=$1 [L,QSA]
  RewriteRule ^apple-touch-icon-([0-9]+x[0-9]+)\.png$ assets/icon.php?size=180 [L,QSA]
  RewriteRule ^apple-touch-icon-precomposed\.png$ assets/icon.php?size=180 [L,QSA]
  RewriteRule ^apple-touch-icon\.png$ assets/icon.php?size=180 [L,QSA]
</IfModule>
