{
  "name": "RSS Reader",
  "short_name": "RSS",
  "description": "Persönlicher Web-RSS-Reader",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#175d3b",
  "theme_color": "#175d3b",
  "orientation": "portrait",
  "icons": [
    { "src": "assets/icon.svg?v=4",            "sizes": "any",     "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "assets/icon.php?size=192&v=4",   "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon.php?size=512&v=4",   "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon.php?size=180&v=4",   "sizes": "180x180", "type": "image/png" }
  ]
}
